<?xml version="1.0" encoding="utf-8"?>
<!-- The UI fonts, looked up through these strings so a locale can swap in a system family: Outfit has no
     glyphs for most Vietnamese accented letters, so values-vi points them at the system sans-serif (#833). -->
<!-- ham_tutor R3 look: every UI font is PT Mono, the LCD face of the app (lib/theme/r3_theme.dart R3Fonts.lcd). -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ReferenceType">
    <string name="font_body" translatable="false">@font/pt_mono</string>
    <string name="font_regular" translatable="false">@font/pt_mono</string>
    <string name="font_light" translatable="false">@font/pt_mono</string>
    <string name="font_extralight" translatable="false">@font/pt_mono</string>
    <string name="font_medium" translatable="false">@font/pt_mono</string>
</resources>
