<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.TvHome" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@android:color/black</item>
        <item name="android:colorBackground">@android:color/black</item>
        <item name="android:windowAnimationStyle">@null</item>
        <!-- The gray backlight until R3Backlight applies the chosen one. -->
        <item name="r3Lcd">#FFB9BCB8</item>
        <item name="r3Ink">#FF1F2221</item>
        <item name="r3InvBg">#FF1F2221</item>
        <item name="r3InvFg">#FFB9BCB8</item>
        <item name="r3Panel">#FFC2C5C1</item>
    </style>

    <!-- ham_tutor LcdPalette, one style per backlight, applied over any activity theme by R3Backlight. -->
    <style name="R3Backlight" />
    <style name="R3Backlight.Dark">
        <item name="r3Lcd">#FF23292B</item>
        <item name="r3Ink">#FFC3CFCF</item>
        <item name="r3InvBg">#FF9DB0B1</item>
        <item name="r3InvFg">#FF1E2426</item>
        <item name="r3Panel">#FF2C3335</item>
    </style>
    <style name="R3Backlight.Gray">
        <item name="r3Lcd">#FFB9BCB8</item>
        <item name="r3Ink">#FF1F2221</item>
        <item name="r3InvBg">#FF1F2221</item>
        <item name="r3InvFg">#FFB9BCB8</item>
        <item name="r3Panel">#FFC2C5C1</item>
    </style>
    <style name="R3Backlight.Amber">
        <item name="r3Lcd">#FF1E1A13</item>
        <item name="r3Ink">#FFF0B457</item>
        <item name="r3InvBg">#FFF0B457</item>
        <item name="r3InvFg">#FF1E1A13</item>
        <item name="r3Panel">#FF2A2419</item>
    </style>
    <style name="R3Backlight.Green">
        <item name="r3Lcd">#FFB3BBAD</item>
        <item name="r3Ink">#FF1F241E</item>
        <item name="r3InvBg">#FF1F241E</item>
        <item name="r3InvFg">#FFB3BBAD</item>
        <item name="r3Panel">#FFBCC4B6</item>
    </style>

    <!-- nav_sound: the system clicks off for every view, so only NavSound plays. -->
    <style name="Theme.TvHome.Quiet">
        <item name="android:soundEffectsEnabled">false</item>
    </style>

    <!-- Frosted pill, tvOS style. -->
    <style name="TopButtonBase">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">42dp</item>
        <item name="android:layout_marginStart">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/pill_bg</item>
        <item name="android:textColor">@drawable/pill_text</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">@string/font_medium</item>
        <item name="android:letterSpacing">0.01</item>
        <item name="android:drawablePadding">9dp</item>
        <item name="android:drawableTint">@drawable/pill_text</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="TopButton" parent="TopButtonBase" />

    <!-- Icon-only pill: a 42dp circle (pill_bg's 21dp corners) with the 22dp icon centred by even padding. Give it a
         contentDescription, since there is no text. -->
    <style name="TopButtonIcon" parent="TopButtonBase">
        <item name="android:layout_width">42dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:drawablePadding">0dp</item>
    </style>

    <style name="SettingsRow">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:background">@drawable/settings_choice_bg</item>
        <item name="android:textColor">#FFFFFFFF</item>
        <item name="android:textSize">18sp</item>
        <item name="android:focusable">true</item>
        <item name="android:clickable">true</item>
    </style>
    <style name="SettingsColumnChoice" parent="SettingsRow">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginEnd">10dp</item>
        <item name="android:gravity">center</item>
    </style>
</resources>
