<?xml version="1.0" encoding="utf-8"?>
<!-- ham_tutor R3: the transceiver round the screen. The light case (R3Theme.bodyTop/bodyBottom), the dark bezel
     (bezelTop/bezelBottom) and the LCD in the backlight's colour. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FFE6E6E3" android:endColor="#FFCBCBC7" />
        </shape>
    </item>
    <item android:left="5dp" android:top="5dp" android:right="5dp" android:bottom="5dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#FF36373A" android:endColor="#FF2C2D30" />
            <corners android:radius="10dp" />
        </shape>
    </item>
    <item android:left="13dp" android:top="13dp" android:right="13dp" android:bottom="13dp">
        <shape android:shape="rectangle">
            <solid android:color="?attr/r3Lcd" />
            <corners android:radius="6dp" />
        </shape>
    </item>
</layer-list>
